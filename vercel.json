{
  "headers": [
    {
      "source": "/(llms\\.txt|llms-full\\.txt)",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.tonyenglish.vn"
        }
      ],
      "destination": "https://tonyenglish.vn/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "lms.tonyenglish.vn"
        }
      ],
      "destination": "https://tonyenglish.vn/:path*",
      "permanent": true
    },
    {
      "source": "/courses/toeic",
      "destination": "/courses/business-office-english",
      "permanent": true
    },
    {
      "source": "/courses/toeic.html",
      "destination": "/courses/business-office-english",
      "permanent": true
    },
    {
      "source": "/vi/courses/toeic.html",
      "destination": "/courses/business-office-english",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/uploads/FlashQuiz/:dir*/index.html",
      "destination": "/api/flashquiz?dir=:dir*&file=index.html"
    },
    {
      "source": "/uploads/FlashQuiz/:dir*/html5-unsupported.html",
      "destination": "/api/flashquiz?dir=:dir*&file=html5-unsupported.html"
    },
    {
      "source": "/uploads/FlashQuiz/:dir*/goodbye.html",
      "destination": "/api/flashquiz?dir=:dir*&file=goodbye.html"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://ubkvzgwespfvrlpjuxkp.supabase.co/storage/v1/object/public/tonyenglish_uploads/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
