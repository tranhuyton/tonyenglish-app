            {
              "id": "4",
              "content": "What is something that a volcano does?",
              "options": [
                "a. Fate",
                "b. Erupt",
                "c. Remainder",
                "d. Sympathy"
              ],
              "explanation": "Erupt: To shoot a hot substance.",
              "correctAnswer": "B"
            },
            {
              "id": "5",
              "content": "What is it called to have belief in something magical?",
              "options": [
                "a. Superstition",
                "b. Vibrate",
                "c. Agency",
                "d. Confine"
              ],
              "explanation": "Superstition: Something magical that people believe is real.",
              "correctAnswer": "A"
            }
          ],
          "questionType": "Trắc nghiệm"
