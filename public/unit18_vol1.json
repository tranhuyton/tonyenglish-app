              "explanation": "depend: phụ thuộc",
              "correctAnswer": "C"
            },
            {
              "id": "3",
              "content": "3. price",
              "options": [
                "a. a sweet candy",
                "b. how much something costs",
                "c. a music show",
                "d. a school"
              ],
              "explanation": "price: giá tiền",
              "correctAnswer": "B"
            },
            {
              "id": "4",
              "content": "4. select",
              "options": [
                "a. to change",
                "b. to keep doing something",
                "c. to choose",
                "d. to fight"
              ],
              "explanation": "select: lựa chọn",
              "correctAnswer": "C"
            },
            {
              "id": "5",
              "content": "5. item",
              "options": [
                "a. a path",
                "b. someone who keeps the law",
                "c. a thing",
                "d. a place to watch a show"
              ],
              "explanation": "item: món đồ, sự vật",
              "correctAnswer": "C"
            },
            {
              "id": "6",
              "content": "6. tool",
