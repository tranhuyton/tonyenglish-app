            {
              "id": "7",
              "content": "7. crowd",
              "options": [
                "a. a group of people",
                "b. a flat piece of wood",
                "c. 100 years",
                "d. a sign"
              ],
              "explanation": "crowd: đám đông",
              "correctAnswer": "A"
            },
            {
