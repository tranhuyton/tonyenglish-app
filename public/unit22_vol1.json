        {
          "id": "sec2_wordlist",
          "title": "Exercise 2: Check (√) the sentence with the bolded word that makes better sense.",
          "content": "",
          "questions": [
            {
              "id": "6",
              "content": "Which sentence makes better sense?",
              "options": [
                "If I <b>receive</b> a present, I give someone something.",
                "If you <b>steal</b> money, you can get in trouble."
              ],
              "explanation": "Ăn cắp tiền (steal money) thì sẽ gặp rắc rối.",
              "correctAnswer": "B"
            },
            {
              "id": "7",
              "content": "Which sentence makes better sense?",
