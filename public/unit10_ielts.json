        {
          "title": "Exercise 3: Mark each statement T for true or F for false.",
          "content": "<p class=\"font-bold text-[16px] text-slate-800 mb-4\">True / False</p>",
          "questionType": "TFNG",
          "questions": [
            {
              "id": 9,
              "content": "If you say something 'aloud', you whisper it so nobody can hear.",
              "options": [
                "True",
                "False"
              ],
              "correctAnswer": "False",
              "explanation": "False. Aloud means saying something so others can hear you."
            },
            {
              "id": 10,
              "content": "A 'blanket' is a piece of cloth used to keep warm.",
              "options": [
                "True",
                "False"
              ],
              "correctAnswer": "True",
              "explanation": "True. A blanket is used to keep warm or to sit upon."
            },
            {
              "id": 11,
              "content": "To 'creep' means to run fast and make loud noises.",
              "options": [
                "True",
                "False"
              ],
              "correctAnswer": "False",
              "explanation": "False. To creep means to move quietly and slowly."
