            {
              "id": 1,
              "content": "My mother ________ me when I was trying to listen to music.",
              "options": [
                "froze",
                "interrupted",
                "denied",
                "emphasized"
              ],
              "correctAnswer": "B",
              "explanation": "Interrupt means to briefly stop someone when they are doing something."
            },
            {
              "id": 2,
              "content": "She ________ the key points by circling them in red ink.",
              "options": [
                "gestured",
                "lasted",
                "emphasized",
                "denied"
              ],
              "correctAnswer": "C",
              "explanation": "Emphasize means to give importance or attention to something."
            },
            {
              "id": 3,
              "content": "Lydia had a high ________ so she didn't go to school.",
              "options": [
                "flu",
                "fever",
                "freeze",
                "gesture"
              ],
              "correctAnswer": "B",
              "explanation": "Fever is a high body temperature that people get when they are sick."
            },
            {
              "id": 4,
              "content": "The football match ________ for nearly two hours.",
              "options": [
                "denied",
                "interrupted",
                "froze",
                "lasted"
              ],
              "correctAnswer": "D",
              "explanation": "Last means to continue or go on for an amount of time."
            },
            {
              "id": 5,
              "content": "He was given an official ________ proving he was a citizen.",
              "options": [
                "chamber",
                "document",
                "gesture",
                "fever"
              ],
              "correctAnswer": "B",
              "explanation": "Document is an official piece of writing."
