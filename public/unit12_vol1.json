        {
          "id": "sec2_wordlist_part_b",
          "title": "Exercise 1 - Part B: Write a word that is similar in meaning to the underlined part.",
          "content": "",
          "questions": [
            {
              "id": "6",
              "content": "1. I don't like <u>the person who lives near me</u>.<br/>ne [ 6 ]",
              "explanation": "neighbor: người hàng xóm",
              "correctAnswer": "neighbor"
            },
