            {
              "id": "4",
              "content": "4. What is a hazard on a street?",
              "options": [
                "A stop sign",
                "A hole in the ground",
                "A carpool lane",
                "A crosswalk"
              ],
              "correctAnswer": "B",
              "explanation": "b. A hole in the ground"
            },
            {
              "id": "5",
              "content": "5. What can contaminate the air?",
              "options": [
                "A poison",
                "A flower",
                "A mosquito",
                "A flag"
              ],
              "correctAnswer": "A",
              "explanation": "a. A poison"
            },
            {
              "id": "6",
              "content": "6. Which of the following is the most serious to have a deficiency of?",
