          "questions": [
            {
              "id": "1",
              "content": "1. Sam was happy to <u>go back to</u> his house.<br/>re [ 1 ]",
              "explanation": "Câu này đúng vì phù hợp với ngữ cảnh của bài.",
              "correctAnswer": "return"
            },
            {
              "id": "2",
              "content": "2. Her grandfather is a <u>smart</u> old man.<br/>wi [ 2 ]",
              "explanation": "Câu này đúng vì phù hợp với ngữ cảnh của bài.",
              "correctAnswer": "wise"
            },
            {
              "id": "3",
              "content": "3. William wanted an <u>animal to live with</u>.<br/>pe [ 3 ]",
              "explanation": "Câu này đúng vì phù hợp với ngữ cảnh của bài.",
              "correctAnswer": "pet"
            },
            {
              "id": "4",
              "content": "4. He studies what the <u>condition of the air</u> is like.<br/>we [ 4 ]",
              "explanation": "Câu này đúng vì phù hợp với ngữ cảnh của bài.",
              "correctAnswer": "weather"
            },
            {
              "id": "5",
              "content": "5. I have to <u>deal with</u> my rising credit card bill.<br/>fa [ 5 ]",
              "explanation": "Câu này đúng vì phù hợp với ngữ cảnh của bài.",
              "correctAnswer": "face"
