              "correctAnswer": "B",
              "explanation": "\"raisin\" nghĩa là nho khô, có liên quan đến \"grape\" (quả nho)."
            },
            {
              "id": "q5",
              "content": "5. idle",
              "options": [
                "doing nothing",
                "affected",
                "plate",
                "to have food come up"
