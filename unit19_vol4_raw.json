            {
              "id": "q2",
              "content": "2. retain",
              "options": [
                "to keep",
                "to join",
                "to do",
                "to press a switch"
              ],
              "correctAnswer": "A",
              "explanation": "\"retain\" nghĩa là giữ lại, tương đương với \"to keep\"."
            },
            {
              "id": "q3",
              "content": "3. vivid",
              "options": [
